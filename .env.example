# Скопируйте в .env и подставьте значения из Supabase Dashboard
# Project Settings → API → Project URL и anon / publishable key

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Только публичный (anon / publishable) ключ — для браузера!
# Формат: eyJhbGciOi...  или  sb_publishable_...
# НЕ используйте service_role / secret (sb_secret_...) — будет Forbidden
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here